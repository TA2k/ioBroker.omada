{
  "i18n": true,
  "type": "panel",
  "items": {
    "connectionType": {
      "type": "select",
      "label": {
        "en": "Controller type",
        "de": "Controller-Typ"
      },
      "options": [
        {
          "label": {
            "en": "Local controller (software / hardware)",
            "de": "Lokaler Controller (Software / Hardware)"
          },
          "value": "local"
        },
        {
          "label": {
            "en": "Cloud-based controller (Open API)",
            "de": "Cloud-basierter Controller (Open API)"
          },
          "value": "cloud"
        }
      ],
      "newLine": true,
      "sm": 3
    },
    "ip": {
      "type": "text",
      "label": {
        "en": "Omada IP",
        "de": "Omada IP",
        "ru": "Омада IP",
        "pt": "Omada IP",
        "nl": "Omada IP",
        "fr": "Omada IP",
        "it": "Omada IP",
        "es": "Omada IP",
        "pl": "Omada IP",
        "uk": "Омада IP",
        "zh-cn": "OmadaIP"
      },
      "newLine": true,
      "sm": 3,
      "hidden": "data.connectionType === 'cloud'"
    },
    "port": {
      "type": "text",
      "label": {
        "en": "Omada Port (Hardware Controller default Port = 443)",
        "de": "Omada Port (Hardware Controller default Port = 443)",
        "ru": "Порт Омада (Hardware Controller default Port = 443)",
        "pt": "Porta Omada (Porta padrão de Hardware Controller = 443)",
        "nl": "Omada Port (Hardware Controller default Port = 443)",
        "fr": "Port Omada (port par défaut du logiciel Port = 443)",
        "it": "Porto di Omada (Porto predefinito di Hardware Controller = 443)",
        "es": "Puerto de Omada (porto por defecto de Hardware Controller = 443)",
        "pl": "Port Omada (ang.)",
        "uk": "Omada Порт (Hardware Controller за замовчуванням Порт = 443)",
        "zh-cn": "Omada Port(Hadware违约港口=443)"
      },
      "newLine": true,
      "sm": 3,
      "hidden": "data.connectionType === 'cloud'"
    },
    "username": {
      "type": "text",
      "label": {
        "en": "Username",
        "de": "Benutzername",
        "ru": "Имя пользователя",
        "pt": "Nome de utilizador",
        "nl": "Noem",
        "fr": "Nom",
        "it": "Nome utente",
        "es": "Nombre de usuario",
        "pl": "Username",
        "uk": "Ім'я користувача",
        "zh-cn": "用户名称"
      },
      "newLine": true,
      "sm": 3,
      "hidden": "data.connectionType === 'cloud'"
    },
    "password": {
      "type": "password",
      "newLine": true,
      "repeat": false,
      "visible": true,
      "sm": 3,
      "label": {
        "en": "Password",
        "de": "Passwort",
        "ru": "Пароль",
        "pt": "Senha",
        "nl": "Wachtwoord",
        "fr": "Mot de passe",
        "it": "Password",
        "es": "Contraseña",
        "pl": "Password",
        "uk": "Логін",
        "zh-cn": "护照"
      },
      "hidden": "data.connectionType === 'cloud'"
    },
    "cloudUrl": {
      "type": "text",
      "label": {
        "en": "Open API interface access address (e.g. https://euw1-omada-northbound.tplinkcloud.com)",
        "de": "Open API Interface-Zugriffsadresse (z.B. https://euw1-omada-northbound.tplinkcloud.com)"
      },
      "hidden": "data.connectionType !== 'cloud'",
      "newLine": true,
      "sm": 3
    },
    "cloudOmadacId": {
      "type": "text",
      "label": {
        "en": "Omada ID",
        "de": "Omada ID"
      },
      "hidden": "data.connectionType !== 'cloud'",
      "newLine": true,
      "sm": 3
    },
    "clientId": {
      "type": "text",
      "label": {
        "en": "Client ID",
        "de": "Client ID"
      },
      "hidden": "data.connectionType !== 'cloud'",
      "newLine": true,
      "sm": 3
    },
    "clientSecret": {
      "type": "password",
      "label": {
        "en": "Client Secret",
        "de": "Client Secret"
      },
      "hidden": "data.connectionType !== 'cloud'",
      "newLine": true,
      "sm": 3,
      "repeat": false,
      "visible": true
    },
    "cloudHelp": {
      "type": "staticText",
      "hidden": "data.connectionType !== 'cloud'",
      "newLine": true,
      "text": {
        "en": "Create an app under Global View > Settings > Platform Integration > Open API (Client Mode). An admin role is required to enable/disable SSIDs.",
        "de": "App unter Global View > Einstellungen > Plattform-Integration > Open API anlegen (Client-Modus). Zum Ein-/Ausschalten von SSIDs ist eine Admin-Rolle nötig."
      }
    },
    "interval": {
      "type": "number",
      "newLine": true,
      "min": 1,
      "sm": 2,
      "label": {
        "en": "Update interval (in seconds)",
        "de": "Updateintervall (in Sekunden)",
        "ru": "Интервал обновления (в секундах)",
        "pt": "Intervalo de atualização (em segundos)",
        "nl": "Update interval (in seconden)",
        "fr": "Intervalle de mise à jour (en secondes)",
        "it": "Intervallo di aggiornamento (in secondi)",
        "es": "Intervalo de actualización (en segundos)",
        "pl": "Update interval (ang.)",
        "uk": "Період оновлення (в секундах)",
        "zh-cn": "最新间隔(第二期)"
      }
    }
  }
}
